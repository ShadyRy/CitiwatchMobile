<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:background="@color/colorBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CITIWATCH"
            android:textSize="18sp"
            android:textColor="@color/textDark"
            android:textStyle="bold"
            android:letterSpacing="0.05"/>

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_bell"
            android:contentDescription="Notifications"/>
    </LinearLayout>

    <!-- Scrollable body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Orange Banner Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_orange_banner"
                android:padding="20dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Community Alert\n&amp; Action Hub"
                    android:textSize="22sp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Report hazards near you and follow\nhow your barangay responds."
                    android:textSize="13sp"
                    android:textColor="#EEEEEE"
                    android:layout_marginBottom="20dp"/>

                <Button
                    android:id="@+id/btnReportIssue"
                    android:layout_width="170dp"
                    android:layout_height="42dp"
                    android:text="Report an Issue  ›"
                    android:textSize="13sp"
                    android:textColor="@color/primaryOrange"
                    android:textStyle="bold"
                    android:background="@drawable/bg_white_pill_button"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Recent Reports Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent reports"
                    android:textSize="18sp"
                    android:textColor="@color/textDark"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSeeAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="See All"
                    android:textSize="14sp"
                    android:textColor="@color/primaryOrange"/>
            </LinearLayout>

            <!-- Report Card 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Report image -->
                    <ImageView
                        android:id="@+id/ivReport1"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:background="@color/colorChipBg"
                        android:contentDescription="Broken street light photo"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <!-- Title + Badge row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Broken Street Light"
                                android:textSize="15sp"
                                android:textColor="@color/textDark"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Emergency"
                                android:textSize="11sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_emergency_badge"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"/>
                        </LinearLayout>

                        <!-- Location -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_location_pin"
                                android:layout_marginEnd="4dp"
                                android:contentDescription="Location"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rosario St. corner Araneta Ave."
                                android:textSize="12sp"
                                android:textColor="@color/textGray"/>
                        </LinearLayout>

                        <!-- Likes / Comments / Time row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <!-- Like button -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_chip_unselected"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:layout_marginEnd="8dp">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                    android:src="@drawable/ic_thumbsup" android:layout_marginEnd="4dp"
                                    android:contentDescription="Likes"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="11" android:textSize="12sp" android:textColor="@color/textGray"/>
                            </LinearLayout>

                            <!-- Comment button -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_chip_unselected"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp">
                                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                                    android:src="@drawable/ic_comment" android:layout_marginEnd="4dp"
                                    android:contentDescription="Comments"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="5" android:textSize="12sp" android:textColor="@color/textGray"/>
                            </LinearLayout>

                            <Space android:layout_width="0dp" android:layout_height="wrap_content"
                                android:layout_weight="1"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today, 11:30 AM"
                                android:textSize="11sp"
                                android:textColor="@color/textGray"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Report Card 2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/ivReport2"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:scaleType="centerCrop"
                        android:background="@color/colorChipBg"
                        android:contentDescription="Flooded crossroad photo"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Flooded Crossroad"
                                android:textSize="15sp"
                                android:textColor="@color/textDark"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Emergency"
                                android:textSize="11sp"
                                android:textColor="@color/white"
                                android:background="@drawable/bg_emergency_badge"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                                android:src="@drawable/ic_location_pin" android:layout_marginEnd="4dp"
                                android:contentDescription="Location"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Bangga Lacson, Bacolod City"
                                android:textSize="12sp" android:textColor="@color/textGray"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
